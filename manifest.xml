<?xml version="1.0" encoding="UTF-8"?>
<!--
  Zamień wszystkie wystąpienia https://m4teuszkaczmarek.github.io/outlook-meeting-template na adres, pod którym
  hostujesz pliki add-ina (np. https://twoja-firma.github.io/meeting-template).
-->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
           xsi:type="MailApp">
  <Id>c285c704-ab80-4367-908a-adb5402f6af2</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Summ-IT</ProviderName>
  <DefaultLocale>pl-PL</DefaultLocale>
  <DisplayName DefaultValue="Szablon spotkania"/>
  <Description DefaultValue="Automatycznie dodaje agendę i link do logowania czasu do nowych spotkań."/>
  <IconUrl DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/"/>
  <AppDomains>
    <AppDomain>https://m4teuszkaczmarek.github.io/outlook-meeting-template</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/commands.html"/>
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Appointment" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="mtGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="Button" id="mtInsertButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>insertTemplateCommand</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Szablon"/>
        <bt:String id="Button.Label" DefaultValue="Wstaw szablon"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Wstawia agendę i link do logowania czasu do opisu spotkania."/>
      </bt:LongStrings>
    </Resources>

    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <!-- Nowy Outlook / web: strona HTML; klasyczny Outlook: sam plik JS -->
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="AppointmentOrganizerCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="mtGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="mtInsertButton">
                    <Label resid="Button.Label"/>
                    <Supertip>
                      <Title resid="Button.Label"/>
                      <Description resid="Button.Tooltip"/>
                    </Supertip>
                    <Icon>
                      <bt:Image size="16" resid="Icon.16"/>
                      <bt:Image size="32" resid="Icon.32"/>
                      <bt:Image size="80" resid="Icon.80"/>
                    </Icon>
                    <Action xsi:type="ExecuteFunction">
                      <FunctionName>insertTemplateCommand</FunctionName>
                    </Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewAppointmentOrganizer" FunctionName="onNewAppointmentHandler"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/assets/icon-16.png"/>
          <bt:Image id="Icon.32" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/assets/icon-32.png"/>
          <bt:Image id="Icon.80" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/assets/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/commands.html"/>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://m4teuszkaczmarek.github.io/outlook-meeting-template/launchevent.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="Group.Label" DefaultValue="Szablon"/>
          <bt:String id="Button.Label" DefaultValue="Wstaw szablon"/>
        </bt:ShortStrings>
        <bt:LongStrings>
          <bt:String id="Button.Tooltip" DefaultValue="Wstawia agendę i link do logowania czasu do opisu spotkania."/>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
